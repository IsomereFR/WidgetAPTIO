# ═══════════════════════════════════════════════════════════════════════════
#  Widget « État de la chaîne APTIO » · variables d'environnement
#
#  Copiez ce fichier en `.env.local` pour le développement local, et reportez
#  les mêmes variables dans Vercel (Project Settings → Environment Variables).
#  `.env.local` est ignoré par git : n'y mettez jamais de clé dans un commit.
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase ───────────────────────────────────────────────────────────────
# Projet en région UE (eu-central-1 / Francfort), cf. §5 du PRD.
# Tableau de bord Supabase → Project Settings → API.

# URL du projet. Exposée au navigateur (préfixe NEXT_PUBLIC_), sans risque.
NEXT_PUBLIC_SUPABASE_URL=

# Clé « anon / public ». Exposée au navigateur : c'est normal et voulu.
# La RLS n'autorise que le SELECT, donc elle ne permet aucune écriture.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé « service_role ». SECRÈTE.
# Utilisée uniquement par app/api/etat/route.ts, côté serveur.
# Ne JAMAIS la préfixer NEXT_PUBLIC_, ne jamais la committer.
SUPABASE_SERVICE_ROLE_KEY=

# ── Accès pilote (§9.1 du PRD) ─────────────────────────────────────────────
# Deux modes possibles. Basculez en changeant cette seule variable.
#   pin  → mot de passe unique partagé          ← ARBITRAGE RETENU
#   auth → lien magique Supabase Auth (traçabilité nominative)
ACCES_PILOTE=pin

# ── Si ACCES_PILOTE=pin (mode retenu) ──────────────────────────────────────
# Mot de passe unique exigé par la route d'écriture avant toute publication.
# SECRET : ne jamais committer. Choisissez-le long, il n'est saisi qu'une fois
# par session sur le poste pilote.
PILOTE_PIN=

# ── Si ACCES_PILOTE=auth (mode alternatif) ─────────────────────────────────
# Adresses autorisées à publier, séparées par des virgules.
# Toute autre adresse connectée reçoit un 401 de la route d'écriture.
# Laisser vide en mode « pin ».
PILOTE_EMAILS=

# ── Affichage (facultatif) ─────────────────────────────────────────────────
# Sous-titre affiché sous le titre, dans l'en-tête. Permet de déployer le même
# code sur un second site sans toucher aux sources.
# Variable NEXT_PUBLIC_ : sa valeur est figée au BUILD, pas au démarrage.
NEXT_PUBLIC_SITE_LIBELLE=Site : BEZANNES

# Nombre d'heures sans publication au-delà duquel la page de lecture signale
# que l'état n'est plus confirmé. À caler sur le rythme réel de publication
# du laboratoire. Défaut : 12.
NEXT_PUBLIC_SEUIL_PERIME_HEURES=12
