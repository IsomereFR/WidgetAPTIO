# ═══════════════════════════════════════════════════════════════════════════
#  Variables lues par docker-compose.yml. Copier en `.env` À CÔTÉ du
#  docker-compose.yml, puis renseigner. Ce fichier `.env` contient des secrets :
#  il est ignoré par git et ne doit jamais être committé.
#
#  Détail de chaque variable : docs/HEBERGEMENT-LOCAL.md, §4.
# ═══════════════════════════════════════════════════════════════════════════

# ── Base (Supabase auto-hébergé) ───────────────────────────────────────────
# URL de la passerelle Kong du Supabase interne, joignable par le conteneur
# widget ET par les navigateurs du laboratoire : c'est la même valeur qui est
# inscrite dans le JavaScript envoyé aux postes.
NEXT_PUBLIC_SUPABASE_URL=

# Clé « anon ». Publique par conception : la RLS n'autorise que la lecture.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé « service_role ». SECRÈTE : contourne la RLS. Serveur uniquement.
SUPABASE_SERVICE_ROLE_KEY=

# ── Accès pilote ───────────────────────────────────────────────────────────
# pin → mot de passe unique partagé (mode retenu)
# auth → lien magique e-mail, traçabilité nominative
ACCES_PILOTE=pin

# Si ACCES_PILOTE=pin. SECRET.
PILOTE_PIN=

# Si ACCES_PILOTE=auth. Adresses séparées par des virgules.
PILOTE_EMAILS=

# ── Affichage ──────────────────────────────────────────────────────────────
# Sous-titre de l'en-tête.
NEXT_PUBLIC_SITE_LIBELLE=Site : BEZANNES

# Au-delà de ce nombre d'heures sans publication, la page de lecture signale
# que l'état n'est plus confirmé.
NEXT_PUBLIC_SEUIL_PERIME_HEURES=12
